<Window x:Class="CClean.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CClean.UI"
        Title="YrClean" Height="600" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="10">
            <CheckBox Name="SelectAllCheck"
                      Content="Select all"
                      VerticalAlignment="Center"
                      Margin="0,0,20,0"
                      Checked="SelectAllCheck_Checked"
                      Unchecked="SelectAllCheck_Unchecked"/>
            <Button Name="ScanButton"
                    Content="Scan all sources"
                    Width="150" Height="40"
                    Click="ScanButton_Click"/>
            <Button Name="CleanButton"
                    Content="Clean selected"
                    Width="150" Height="40"
                    Margin="10,0,0,0"
                    Click="CleanButton_Click"/>
            <Button Name="ScheduleButton"
                    Content="Schedule..."
                    Width="120" Height="40"
                    Margin="10,0,0,0"
                    Click="ScheduleButton_Click"/>
        </StackPanel>

        <TreeView Name="ResultsTree" Grid.Row="1" Margin="10" Grid.IsSharedSizeScope="True">
            <TreeView.Resources>
                <Style TargetType="Grid">
                    <Setter Property="Background" Value="Transparent"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#3300A2FF"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <Style TargetType="TreeViewItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Style.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="Black"/>
                    </Style.Resources>
                </Style>

                <HierarchicalDataTemplate DataType="{x:Type local:CacheSourceNode}" ItemsSource="{Binding Children}">
                    <Grid Width="640" Background="#F0F0F0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CheckCol"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="SizeCol"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CountCol"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" FontSize="14" Margin="6,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" Margin="20,0,0,0" HorizontalAlignment="Right" FontWeight="Bold"/>
                        <TextBlock Grid.Column="3" Text="{Binding CountDisplay}" Margin="20,0,0,0" HorizontalAlignment="Right" FontWeight="Bold"/>
                        <Grid.ContextMenu>
                            <ContextMenu Opened="ContextMenu_Opened" Closed="ContextMenu_Closed">
                                <MenuItem Header="Open folder location" Click="OpenLocation_Click"/>
                                <MenuItem Header="Search on the web" Click="SearchWeb_Click"/>
                                <MenuItem Header="Add to exclusions" Click="AddToExclusions_Click"/>
                            </ContextMenu>
                        </Grid.ContextMenu>
                    </Grid>
                </HierarchicalDataTemplate>

                <HierarchicalDataTemplate DataType="{x:Type local:CacheGroupNode}" ItemsSource="{Binding Children}">
                    <Grid Width="620">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CheckCol"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="SizeCol"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CountCol"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" Margin="6,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" Margin="20,0,0,0" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="{Binding CountDisplay}" Margin="20,0,0,0" HorizontalAlignment="Right"/>
                        <Grid.ContextMenu>
                            <ContextMenu Opened="ContextMenu_Opened" Closed="ContextMenu_Closed">
                                <MenuItem Header="Open folder location" Click="OpenLocation_Click"/>
                                <MenuItem Header="Search on the web" Click="SearchWeb_Click"/>
                                <MenuItem Header="Add to exclusions" Click="AddToExclusions_Click"/>
                            </ContextMenu>
                        </Grid.ContextMenu>
                    </Grid>
                </HierarchicalDataTemplate>

                <DataTemplate DataType="{x:Type local:CacheFileNode}">
                    <Grid Width="600">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CheckCol"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="SizeCol"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="6,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" Margin="20,0,0,0" HorizontalAlignment="Right"/>
                        <Grid.ContextMenu>
                            <ContextMenu Opened="ContextMenu_Opened" Closed="ContextMenu_Closed">
                                <MenuItem Header="Open file location" Click="OpenLocation_Click"/>
                                <MenuItem Header="Search on the web" Click="SearchWeb_Click"/>
                            </ContextMenu>
                        </Grid.ContextMenu>
                    </Grid>
                </DataTemplate>
            </TreeView.Resources>
        </TreeView>
    </Grid>
</Window>