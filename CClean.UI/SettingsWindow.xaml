<Window x:Class="CClean.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Schedule settings" Height="320" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <CheckBox Name="ScheduleEnabledCheck" Content="Enable scheduled auto-clean" FontWeight="Bold"/>

        <TextBlock Text="Frequency" Margin="0,16,0,4"/>
        <ComboBox Name="FrequencyCombo" SelectionChanged="FrequencyCombo_SelectionChanged">
            <ComboBoxItem Content="Hourly"/>
            <ComboBoxItem Content="Daily"/>
            <ComboBoxItem Content="Weekly"/>
        </ComboBox>

        <TextBlock Name="DayLabel" Text="Day of week" Margin="0,12,0,4"/>
        <ComboBox Name="DayCombo">
            <ComboBoxItem Content="Monday"/>
            <ComboBoxItem Content="Tuesday"/>
            <ComboBoxItem Content="Wednesday"/>
            <ComboBoxItem Content="Thursday"/>
            <ComboBoxItem Content="Friday"/>
            <ComboBoxItem Content="Saturday"/>
            <ComboBoxItem Content="Sunday"/>
        </ComboBox>

        <TextBlock Name="TimeLabel" Text="Run time (HH:mm, 24h)" Margin="0,12,0,4"/>
        <TextBox Name="TimeTextBox" Text="03:00"/>

        <CheckBox Name="NotifyCheck" Content="Show a notification after each run" Margin="0,16,0,0"/>

        <CheckBox Name="IncludeAutoDiscoveredCheck"
              Content="Include auto-discovered sources in scheduled runs"
              Margin="0,10,0,0"/>

        <Button Content="Save" Height="32" Margin="0,20,0,0" Click="SaveButton_Click"/>
        <TextBlock Name="StatusText" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</Window>